# Categorias e tempos-limite em segundos: (nome, limite 5 km, limite 10 km)
CATEGORIAS = (
    ("Juvenil", 1500, 3120),
    ("Adulto", 1320, 2760),
    ("Master", 1500, 3120),
    ("Veterano", 1800, 3780),
)


def calcular_valor_inscricao(idade, distancia, lote):
    valor = 80 if lote == 1 else 100

    if distancia == 10:
        valor += 20

    if idade >= 60:
        valor *= 0.5

    return valor


def determinar_categoria(idade):
    if 16 <= idade <= 19:
        return "Juvenil"
    elif idade <= 39:
        return "Adulto"
    elif idade <= 59:
        return "Master"
    else:
        return "Veterano"


def gerar_codigo_corredor(nome, idade):
    nomes = nome.strip().split()
    return f"{nomes[0][:3]}{nomes[-1][:3]}{idade}".upper()


def converter_tempo_para_segundos(tempo):
    horas, minutos, segundos = map(int, tempo.split(":"))
    return horas * 3600 + minutos * 60 + segundos


def calcular_pace(tempo, distancia):
    return tempo / distancia


def foi_premiado(categoria, distancia, tempo):
    for nome, limite_5km, limite_10km in CATEGORIAS:
        if nome == categoria:
            limite = limite_5km if distancia == 5 else limite_10km
            return tempo <= limite

    return False


def gerar_codigo_unico(nome, idade, codigos_usados):
    base = gerar_codigo_corredor(nome, idade)
    codigo = base
    numero = 2

    while codigo in codigos_usados:
        codigo = f"{base}-{numero}"
        numero += 1

    return codigo


def contar_por_categoria(corredores):
    contagem = {}

    for nome, _, _ in CATEGORIAS:
        contagem[nome] = 0

    for c in corredores:
        contagem[c["categoria"]] += 1

    return contagem


def cadastrar_corredor(corredores, codigos_usados):
    nome = input("Nome completo: ").strip()

    try:
        idade = int(input("Idade: "))
        distancia = int(input("Distância (5 ou 10 km): "))
        lote = int(input("Lote (1 ou 2): "))
    except ValueError:
        print("Digite números válidos.")
        return

    if idade < 16 or distancia not in (5, 10) or lote not in (1, 2):
        print("Dados inválidos. Confira a idade, distância e lote.")
        return

    codigo = gerar_codigo_unico(nome, idade, codigos_usados)

    corredor = {
        "nome": nome,
        "idade": idade,
        "distancia": distancia,
        "lote": lote,
        "codigo": codigo,
        "categoria": determinar_categoria(idade),
        "valor": calcular_valor_inscricao(idade, distancia, lote),
        "tempo": None
    }

    corredores.append(corredor)
    codigos_usados.add(codigo)

    print("\nInscrição realizada!")
    print("Código:", codigo)
    print("Categoria:", corredor["categoria"])
    print(f"Valor: R$ {corredor['valor']:.2f}")


def listar_inscritos(corredores):
    if not corredores:
        print("Nenhum corredor cadastrado.")
        return

    for c in corredores:
        print(
            f"\nNome: {c['nome']} | Código: {c['codigo']}"
            f"\nCategoria: {c['categoria']} | Distância: {c['distancia']} km"
            f"\nValor: R$ {c['valor']:.2f} | Tempo: {c['tempo']}"
        )


def buscar_corredor(corredores):
    codigo = input("Digite o código do corredor: ").strip().upper()

    for c in corredores:
        if c["codigo"] == codigo:
            print(c)
            return

    print("Corredor não encontrado.")


def registrar_tempo(corredores):
    codigo = input("Código do corredor: ").strip().upper()

    for c in corredores:
        if c["codigo"] == codigo:
            tempo = input("Tempo (HH:MM:SS): ")

            try:
                segundos = converter_tempo_para_segundos(tempo)

                horas, minutos, seg = map(int, tempo.split(":"))

                if horas < 0 or not (0 <= minutos <= 59 and 0 <= seg <= 59):
                    print("Tempo inválido.")
                    return

            except ValueError:
                print("Formato inválido. Use HH:MM:SS.")
                return

            c["tempo"] = tempo
            pace = calcular_pace(segundos, c["distancia"])

            print(f"Tempo registrado! Pace: {pace:.2f} segundos/km")

            if foi_premiado(c["categoria"], c["distancia"], segundos):
                print("Parabéns! O corredor atingiu o limite de premiação.")
            else:
                print("O corredor não atingiu o limite de premiação.")

            return

    print("Corredor não encontrado.")


def calcular_resultado():
    try:
        idade = int(input("Idade: "))
        distancia = int(input("Distância (5 ou 10 km): "))

        if idade < 16 or distancia not in (5, 10):
            print("Idade ou distância inválida.")
            return

        tempo = input("Tempo (HH:MM:SS): ")
        segundos = converter_tempo_para_segundos(tempo)

        horas, minutos, seg = map(int, tempo.split(":"))

        if horas < 0 or not (0 <= minutos <= 59 and 0 <= seg <= 59):
            print("Tempo inválido.")
            return

        categoria = determinar_categoria(idade)
        pace = calcular_pace(segundos, distancia)

        print("\nCategoria:", categoria)
        print("Tempo em segundos:", segundos)
        print(f"Pace: {pace:.2f} segundos/km")

        if foi_premiado(categoria, distancia, segundos):
            print("Corredor premiado!")
        else:
            print("Corredor não premiado.")

    except ValueError:
        print("Dados inválidos. Confira os valores digitados.")


def mostrar_inscritos_por_categoria(corredores):
    print("\nInscritos por categoria:")
    for categoria, quantidade in contar_por_categoria(corredores).items():
        print(f"{categoria}: {quantidade}")


def mostrar_resultados(corredores):
    com_tempo = [c for c in corredores if c["tempo"] is not None]
    premiados = [
        c for c in com_tempo
        if foi_premiado(
            c["categoria"],
            c["distancia"],
            converter_tempo_para_segundos(c["tempo"]),
        )
    ]

    print("\nCom tempo registrado:", len(com_tempo))
    for c in com_tempo:
        print(f"  {c['codigo']} | {c['nome']} | {c['tempo']}")

    print("Premiados:", len(premiados))
    for c in premiados:
        print(f"  {c['codigo']} | {c['nome']} | {c['categoria']}")


def main():
    corredores = []
    codigos_usados = set()

    while True:
        print("\n===== SISTEMA DE CORRIDA =====")
        print("1 - Cadastrar corredor")
        print("2 - Listar inscritos")
        print("3 - Buscar corredor")
        print("4 - Registrar tempo")
        print("5 - Calcular resultado")
        print("6 - Inscritos por categoria")
        print("7 - Resultados (com tempo e premiados)")
        print("8 - Sair")

        opcao = input("Escolha uma opção: ")

        if opcao == "1":
            cadastrar_corredor(corredores, codigos_usados)

        elif opcao == "2":
            listar_inscritos(corredores)

        elif opcao == "3":
            buscar_corredor(corredores)

        elif opcao == "4":
            registrar_tempo(corredores)

        elif opcao == "5":
            calcular_resultado()

        elif opcao == "6":
            mostrar_inscritos_por_categoria(corredores)

        elif opcao == "7":
            mostrar_resultados(corredores)

        elif opcao == "8":
            total = sum(c["valor"] for c in corredores)

            print("\nEncerrando o sistema...")
            print("Total de inscritos:", len(corredores))
            print(f"Total arrecadado: R$ {total:.2f}")
            break

        else:
            print("Opção inválida.")


main()
