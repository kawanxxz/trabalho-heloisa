"""
Sistema da Corrida Noturna da Ponte Estaiada
Disciplina: Programação I - Python (UNIFSA)
"""

# Tupla com categorias e tempos-limite em segundos: (nome, limite 5km, limite 10km)
CATEGORIAS = (
    ("Juvenil", 1500, 3120),   # 00:25:00 e 00:52:00
    ("Adulto", 1320, 2760),    # 00:22:00 e 00:46:00
    ("Master", 1500, 3120),    # 00:25:00 e 00:52:00
    ("Veterano", 1800, 3780)   # 00:30:00 e 01:03:00
)


# ==============================================================================
# FUNÇÕES DE REGRA DE NEGÓCIO (Etapa 1 & 2)
# (Não possuem print nem input, usam docstrings e return)
# ==============================================================================

def calcular_valor_inscricao(idade: int, distancia: int, lote: int) -> float:
    """Calcula o valor da inscrição com base no lote, distância e idade."""
    valor = 80.0 if lote == 1 else 100.0

    if distancia == 10:
        valor += 20.0

    if idade >= 60:
        valor *= 0.5

    return valor


def determinar_categoria(idade: int) -> str:
    """Determina a categoria do corredor conforme a faixa etária."""
    if 16 <= idade <= 19:
        return "Juvenil"
    elif 20 <= idade <= 39:
        return "Adulto"
    elif 40 <= idade <= 59:
        return "Master"
    elif 60 <= idade:
        return "Veterano"
    else:
        return "Idade Inválida"

def extrair_primeiro_nome(nome_completo: str) -> str:
    """
    Extrai o primeiro nome do corredor usando fatiamento (slicing).
    Proibido o uso de split().
    """
    nome_limpo = nome_completo.strip()
    espaco_pos = nome_limpo.find(" ")
    
    if espaco_pos == -1:
        return nome_limpo
    
    return nome_limpo[:espaco_pos]


def gerar_codigo_corredor(nome: str, idade: int) -> str:
    """
    Gera o código do corredor usando exclusivamente slicing:
    3 primeiras letras do primeiro nome + 3 primeiras letras do último sobrenome + idade.
    Proibido o uso de split().
    """
    nome_limpo = nome.strip()
    
    # Busca da posição dos espaços para identificar primeiro e último nome
    primeiro_espaco = nome_limpo.find(" ")
    ultimo_espaco = nome_limpo.rfind(" ")

    if primeiro_espaco == -1:
        # Nome simples (sem sobrenome)
        primeiro_nome = nome_limpo
        ultimo_sobrenome = nome_limpo
    else:
        # Extração estrita via slicing
        primeiro_nome = nome_limpo[:primeiro_espaco]
        ultimo_sobrenome = nome_limpo[ultimo_espaco + 1:]

    tres_primeiras_nome = primeiro_nome[:3].upper()
    tres_primeiras_sobrenome = ultimo_sobrenome[:3].upper()

    return f"{tres_primeiras_nome}{tres_primeiras_sobrenome}{idade}"


def gerar_codigo_unico(nome: str, idade: int, codigos_usados: set) -> str:
    """Gera código único resolvendo conflito se já existir no set de códigos."""
    base = gerar_codigo_corredor(nome, idade)
    codigo = base
    numero = 2

    while codigo in codigos_usados:
        codigo = f"{base}-{numero}"
        numero += 1

    return codigo


def validar_formato_tempo(tempo_str: str) -> bool:
    """Valida se o tempo está no formato estrito HH:MM:SS usando slicing."""
    if len(tempo_str) != 8 or tempo_str[2] != ':' or tempo_str[5] != ':':
        return False
    
    try:
        horas = int(tempo_str[:2])
        minutos = int(tempo_str[3:5])
        segundos = int(tempo_str[6:8])

        if horas < 0 or not (0 <= minutos <= 59) or not (0 <= segundos <= 59):
            return False
        return True
    except ValueError:
        return False


def converter_tempo_para_segundos(tempo_str: str) -> int:
    """
    Converte tempo HH:MM:SS em segundos usando slicing obrigatoriamente.
    (Proibido usar split conforme seções 3.2 e 6.1 do documento).
    """
    horas = int(tempo_str[:2])
    minutos = int(tempo_str[3:5])
    segundos = int(tempo_str[6:8])
    return horas * 3600 + minutos * 60 + segundos


def calcular_pace(tempo_segundos: int, distancia: int) -> str:
    """
    Calcula o pace desprezando as frações de segundo e formata como M'S"/km.
    Exemplo: 1290s / 5km = 258s/km -> 4'18"/km.
    """
    pace_segundos_por_km = int(tempo_segundos // distancia)
    minutos = pace_segundos_por_km // 60
    segundos = pace_segundos_por_km % 60
    return f"{minutos}'{segundos:02d}\"/km"


def foi_premiado(categoria: str, distancia: int, tempo_segundos: int) -> bool:
    """Verifica se o tempo é menor ou igual ao tempo-limite da categoria."""
    for nome_cat, limite_5k, limite_10k in CATEGORIAS:
        if nome_cat == categoria:
            limite = limite_5k if distancia == 5 else limite_10k
            return tempo_segundos <= limite
    return False


def contar_por_categoria(corredores: list) -> dict:
    """Retorna um dicionário com a contagem de inscritos por categoria."""
    contagem = {nome: 0 for nome, _, _ in CATEGORIAS}
    for c in corredores:
        contagem[c["categoria"]] += 1
    return contagem


# ==============================================================================
# FUNÇÕES DE INTERAÇÃO COM USUÁRIO E MENU (Entrada / Saída)
# ==============================================================================

def cadastrar_corredor(corredores: list, codigos_usados: set):
    """Lê os dados, valida entradas e cadastra um novo corredor."""
    print("\n--- CADASTRO DE CORREDOR ---")
    nome = input("Nome completo: ").strip()

    # Validação contínua de entradas
    try:
        idade = int(input("Idade: "))
        if idade < 16:
            print("Inscrição recusada: Apenas maiores de 16 anos podem participar.")
            return
    except ValueError:
        print("Idade inválida.")
        return

    try:
        distancia = int(input("Distância (5 ou 10 km): "))
        if distancia not in (5, 10):
            print("Distância inválida! Escolha 5 ou 10.")
            return
    except ValueError:
        print("Distância inválida.")
        return

    try:
        lote = int(input("Lote (1 ou 2): "))
        if lote not in (1, 2):
            print("Lote inválido! Escolha 1 ou 2.")
            return
    except ValueError:
        print("Lote inválido.")
        return

    # Processamento dos dados
    primeiro_nome = extrair_primeiro_nome(nome)
    codigo = gerar_codigo_unico(nome, idade, codigos_usados)
    categoria = determinar_categoria(idade)
    valor = calcular_valor_inscricao(idade, distancia, lote)

    corredor = {
        "nome": nome,
        "idade": idade,
        "distancia": distancia,
        "lote": lote,
        "codigo": codigo,
        "categoria": categoria,
        "valor": valor,
        "tempo": None
    }

    corredores.append(corredor)
    codigos_usados.add(codigo)

    # Comprovante
    print("\n==========================================")
    print("        COMPROVANTE DE INSCRIÇÃO          ")
    print("==========================================")
    print(f"Primeiro Nome: {primeiro_nome}")
    print(f"Código       : {codigo}")
    print(f"Categoria    : {categoria}")
    print(f"Distância    : {distancia} km")
    print(f"Valor a pagar: R$ {valor:.2f}")
    print("==========================================\n")


def listar_inscritos(corredores: list):
    """Exibe todos os corredores cadastrados no sistema."""
    if not corredores:
        print("\nNenhum corredor cadastrado.")
        return

    print("\n===== LISTA DE INSCRITOS =====")
    for c in corredores:
        tempo_str = c['tempo'] if c['tempo'] is not None else "Não registrado"
        print(
            f"Nome: {c['nome']} | Código: {c['codigo']}\n"
            f"Categoria: {c['categoria']} | Distância: {c['distancia']} km\n"
            f"Valor: R$ {c['valor']:.2f} | Tempo: {tempo_str}\n"
            f"{'-'*40}"
        )


def buscar_corredor(corredores: list):
    """Busca um corredor pelo código gerado."""
    codigo = input("\nDigite o código do corredor: ").strip().upper()

    for c in corredores:
        if c["codigo"] == codigo:
            print(f"\n--- CORREDOR ENCONTRADO ---")
            print(f"Nome     : {c['nome']}")
            print(f"Idade    : {c['idade']}")
            print(f"Categoria: {c['categoria']}")
            print(f"Distância: {c['distancia']} km")
            print(f"Tempo    : {c['tempo'] if c['tempo'] else 'Ainda não registrado'}")
            return

    print("\nCódigo inexistente! Corredor não encontrado.")


def registrar_tempo(corredores: list):
    """Registra o tempo de um corredor cadastrado via HH:MM:SS."""
    codigo = input("\nCódigo do corredor: ").strip().upper()

    for c in corredores:
        if c["codigo"] == codigo:
            tempo = input("Digite o tempo de prova (HH:MM:SS): ").strip()

            if not validar_formato_tempo(tempo):
                print("Formato inválido! Use exatamente HH:MM:SS (minutos e segundos até 59).")
                return

            c["tempo"] = tempo
            segundos = converter_tempo_para_segundos(tempo)
            pace = calcular_pace(segundos, c["distancia"])

            print(f"\nTempo registrado com sucesso!")
            print(f"Tempo em Segundos: {segundos}s")
            print(f"Pace             : {pace}")

            if foi_premiado(c["categoria"], c["distancia"], segundos):
                print("Resultado        : PARABÉNS! Corredor premiado!")
            else:
                print("Resultado        : Não atingiu o limite de premiação.")
            return

    print("\nCódigo inexistente! Não foi possível registrar o tempo.")


def simular_resultado_direto():
    """Simula o resultado de um corredor sem precisar cadastrar no sistema."""
    print("\n--- CALCULAR RESULTADO INDIVIDUAL ---")
    try:
        idade = int(input("Idade: "))
        if idade < 16:
            print("Idade mínima de 16 anos não atingida.")
            return

        distancia = int(input("Distância (5 ou 10 km): "))
        if distancia not in (5, 10):
            print("Distância inválida!")
            return

        tempo = input("Tempo de prova (HH:MM:SS): ").strip()
        if not validar_formato_tempo(tempo):
            print("Formato de tempo inválido!")
            return

        segundos = converter_tempo_para_segundos(tempo)
        categoria = determinar_categoria(idade)
        pace = calcular_pace(segundos, distancia)
        premiado = foi_premiado(categoria, distancia, segundos)

        print("\n-------------------------------------")
        print(f"Categoria        : {categoria}")
        print(f"Tempo em segundos: {segundos} s")
        print(f"Pace             : {pace}")
        print(f"Premiado?        : {'Sim' if premiado else 'Não'}")
        print("-------------------------------------")

    except ValueError:
        print("Entrada de dados inválida!")


def mostrar_resultados_gerais(corredores: list):
    """
    Exibe os resultados consolidados com uso de List Comprehensions (Requisito 4.2).
    """
    # Comprehensions exigidas na Seção 4.2
    com_tempo = [c for c in corredores if c["tempo"] is not None]
    premiados = [
        c for c in com_tempo 
        if foi_premiado(c["categoria"], c["distancia"], converter_tempo_para_segundos(c["tempo"]))
    ]

    print("\n===== RESULTADOS DA CORRIDA =====")
    print(f"Corredores com tempo registrado: {len(com_tempo)}")
    for c in com_tempo:
        seg = converter_tempo_para_segundos(c["tempo"])
        pace = calcular_pace(seg, c["distancia"])
        print(f"  {c['codigo']} | {c['nome']} | Tempo: {c['tempo']} | Pace: {pace}")

    print(f"\nCorredores Premiados: {len(premiados)}")
    for c in premiados:
        print(f"  {c['codigo']} | {c['nome']} | Categoria: {c['categoria']} ({c['distancia']}km)")


def classificacao_geral(corredores: list):
    """Classificação geral ordenada por menor tempo em cada distância (Nível Avançado)."""
    print("\n===== CLASSIFICAÇÃO GERAL =====")
    for dist in (5, 10):
        print(f"\n--- Prova de {dist} km ---")
        filtrados = [c for c in corredores if c["distancia"] == dist and c["tempo"] is not None]

        if not filtrados:
            print("Nenhum tempo registrado nesta distância.")
        else:
            filtrados.sort(key=lambda c: converter_tempo_para_segundos(c["tempo"]))
            for posicao, c in enumerate(filtrados, 1):
                seg = converter_tempo_para_segundos(c["tempo"])
                pace = calcular_pace(seg, dist)
                print(f"{posicao}º lugar: {c['codigo']} - {c['nome']} | Tempo: {c['tempo']} | Pace: {pace}")


def podio_por_categoria(corredores: list):
    """Pódio com os 3 melhores tempos por categoria em cada distância (Nível Avançado)."""
    print("\n===== PÓDIO POR CATEGORIA =====")
    for dist in (5, 10):
        print(f"\n================ Prova {dist} km ================")
        for nome_cat, _, _ in CATEGORIAS:
            filtrados = [
                c for c in corredores 
                if c["distancia"] == dist and c["categoria"] == nome_cat and c["tempo"] is not None
            ]

            print(f"\nCategoria: {nome_cat}")
            if not filtrados:
                print("  Nenhum tempo registrado.")
            else:
                filtrados.sort(key=lambda c: converter_tempo_para_segundos(c["tempo"]))
                for pos, c in enumerate(filtrados[:3], 1):
                    print(f"  {pos}º lugar: {c['codigo']} - {c['nome']} | Tempo: {c['tempo']}")


def relatorio_final(corredores: list):
    """Exibe o relatório final antes de encerrar o programa (Seção 4.3)."""
    print("\n==========================================")
    print("             RELATÓRIO FINAL              ")
    print("==========================================")
    print("Total de inscritos :", len(corredores))
    
    total_arrecadado = sum(c["valor"] for c in corredores)
    print(f"Total arrecadado   : R$ {total_arrecadado:.2f}")

    for dist in (5, 10):
        print(f"\n--- Estatísticas - {dist} km ---")
        com_tempo = [c for c in corredores if c["distancia"] == dist and c["tempo"] is not None]

        if not com_tempo:
            print("  Nenhum tempo registrado nesta distância.")
        else:
            soma_segundos = sum(converter_tempo_para_segundos(c["tempo"]) for c in com_tempo)
            media_segundos = soma_segundos / len(com_tempo)
            mais_rapido = min(com_tempo, key=lambda c: converter_tempo_para_segundos(c["tempo"]))

            print(f"  Tempo médio          : {media_segundos:.1f} segundos")
            print(f"  Corredor mais rápido : {mais_rapido['codigo']} - {mais_rapido['nome']} ({mais_rapido['tempo']})")

    print("\nSistema encerrado. Obrigado!")


def carregar_dados_exemplo(corredores: list, codigos_usados: set):
    """
    Carrega corredores de teste baseados na tabela oficial da Seção 3.2 do documento.
    """
    dados = [
        ("Maria Clara Sousa", 34, 5, 1, "00:21:30"),
        ("José Ribamar Lima", 62, 10, 2, "01:02:59"),
        ("Ana Beatriz Costa", 19, 10, 1, None),
        ("Paulo Henrique Rocha", 60, 5, 1, "00:22:00"),
        ("Carlos Eduardo Luz", 25, 5, 2, "00:20:15"),
        ("Fernanda Maria Silva", 45, 10, 1, "00:55:10"),
        ("Lucas Gabriel Santos", 18, 5, 1, "00:24:50"),
        ("Raimundo Nonato Castro", 65, 10, 2, "01:00:10")
    ]

    for nome, idade, dist, lote, tempo in dados:
        codigo = gerar_codigo_unico(nome, idade, codigos_usados)
        categoria = determinar_categoria(idade)
        valor = calcular_valor_inscricao(idade, dist, lote)
        
        corredores.append({
            "nome": nome,
            "idade": idade,
            "distancia": dist,
            "lote": lote,
            "codigo": codigo,
            "categoria": categoria,
            "valor": valor,
            "tempo": tempo
        })
        codigos_usados.add(codigo)

def main():
    corredores = []
    codigos_usados = set()

    # Carrega dados para facilitar os testes da banca
    carregar_dados_exemplo(corredores, codigos_usados)

    while True:
        print("\n==========================================")
        print("   SISTEMA CORRIDA PONTE ESTAIADA (UNIFSA)")
        print("==========================================")
        print("1 - Cadastrar corredor")
        print("2 - Listar inscritos")
        print("3 - Buscar corredor por código")
        print("4 - Registrar tempo de prova")
        print("5 - Calcular resultado (simulação individual)")
        print("6 - Inscritos por categoria")
        print("7 - Ver resultados (com tempo e premiados)")
        print("8 - Classificação geral por distância")
        print("9 - Pódio por categoria")
        print("10 - Sair e exibir relatório final")
        print("==========================================")

        opcao = input("Escolha uma opção (1-10): ").strip()

        if opcao == "1":
            cadastrar_corredor(corredores, codigos_usados)
        elif opcao == "2":
            listar_inscritos(corredores)
        elif opcao == "3":
            buscar_corredor(corredores)
        elif opcao == "4":
            registrar_tempo(corredores)
        elif opcao == "5":
            simular_resultado_direto()
        elif opcao == "6":
            print("\nInscritos por Categoria:")
            for cat, total in contar_por_categoria(corredores).items():
                print(f"  {cat}: {total}")
        elif opcao == "7":
            mostrar_resultados_gerais(corredores)
        elif opcao == "8":
            classificacao_geral(corredores)
        elif opcao == "9":
            podio_por_categoria(corredores)
        elif opcao == "10":
            relatorio_final(corredores)
            break
        else:
            print("\nOpção inválida! Escolha um número de 1 a 10.")


if __name__ == "__main__":
    main()
